---
// Lightweight, dependency-free scroll-reveal for the homepage.
// Wraps each `.ctx-reveal` element and fades/slides it in once it enters
// the viewport. Respects `prefers-reduced-motion` and degrades to plain
// visible content if JS is disabled.
---

<script>
  const supportsIO = 'IntersectionObserver' in window;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const targets = document.querySelectorAll<HTMLElement>('.ctx-reveal');

  if (!supportsIO || reduceMotion) {
    targets.forEach((el) => el.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>

<style is:global>
  .ctx-reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: var(--ctx-reveal-delay, 0s);
  }

  .ctx-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .ctx-reveal {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
